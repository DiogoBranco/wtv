#!/usr/bin/env bash
set -euo pipefail

panes='wtv --panes --close-window'

resolve_worktree() {
  local target="$1"
  if [ -d "$target" ]; then
    (cd "$target" && git rev-parse --show-toplevel 2>/dev/null || pwd -P)
    return
  fi
  git worktree list --porcelain | awk -v target="$target" '
    /^worktree / { path = substr($0, 10) }
    /^branch refs\/heads\// {
      branch = substr($0, 19)
      count = split(path, parts, "/")
      if (branch == target || parts[count] == target) { print path; exit }
    }
  '
}

session_for() {
  local path="$1"
  # $'' so \t reaches tmux as a real tab: tmux does not expand escapes in formats,
  # and a literal backslash-t stops read from splitting the fields.
  tmux list-sessions -F $'#{session_name}\t#{@wtv_worktree}' 2>/dev/null \
    | while IFS=$'\t' read -r name worktree; do
        [ -n "$worktree" ] || continue
        [ "$(cd "$worktree" 2>/dev/null && pwd -P || true)" = "$path" ] && { echo "$name"; break; }
      done
}

ensure_session() {
  local path="$1"
  local existing
  existing="$(session_for "$path")"
  if [ -n "$existing" ]; then
    echo "$existing"
    return
  fi
  local slug hash prefix name
  slug="$(printf %s "$(basename "$path")" | tr -c '[:alnum:]_-' '-')"
  # Not the same hash wtv itself uses (FNV-1a), so the same worktree gets a
  # different session name depending on who created it. Harmless: identity is
  # the @wtv_worktree option, never the name.
  if command -v sha256sum >/dev/null 2>&1; then
    hash="$(printf %s "$path" | sha256sum | cut -c1-6)"
  else
    hash="$(printf %s "$path" | shasum -a 256 | cut -c1-6)"
  fi
  prefix="${WTV_SESSION:+${WTV_SESSION}-}"
  name="${prefix}${slug}-${hash}"
  tmux new-session -d -s "$name" -c "$path" -n "$slug" "$panes"
  tmux set-option -t "$name" @wtv_worktree "$path"
  echo "$name"
}

paths=()
if [ "$#" -eq 0 ]; then
  paths+=("$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)")
else
  for target in "$@"; do
    path="$(resolve_worktree "$target")"
    [ -n "$path" ] || { echo "worktree not found: $target" >&2; exit 1; }
    paths+=("$(cd "$path" && pwd -P)")
  done
fi

first=""
for path in "${paths[@]}"; do
  session="$(ensure_session "$path")"
  [ -n "$first" ] || first="$session"
done

# WTV_SESSION prefixes generated names; identity always comes from @wtv_worktree.
if [ ! -t 0 ]; then
  echo "session $first ready"
  exit 0
fi
if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$first"
fi
exec tmux attach -t "$first"
