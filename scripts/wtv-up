#!/usr/bin/env bash
set -euo pipefail

session="${WTV_SESSION:-work}"
panes='wtv --panes --close-session'

# Each terminal gets its own session grouped onto the shared one: the windows are
# the same, but the active-window pointer is per client, so two tabs can sit in
# different worktrees instead of dragging each other around. The view dies with
# the client; the shared session outlives it.
attach() {
  if [ ! -t 0 ]; then
    echo "session $session ready"
    return 0
  fi
  # Views left behind by terminals that died without detaching cleanly.
  tmux list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null \
    | awk -v prefix="$session-" '$1 ~ "^"prefix && $2 == 0 {print $1}' \
    | while read -r stale; do tmux kill-session -t "$stale" 2>/dev/null || true; done
  local view="$session-$$"
  # destroy-unattached is set by the attaching command, never before it: setting it
  # on a session with no client destroys that session immediately.
  if tmux new-session -d -t "$session" -s "$view" 2>/dev/null; then
    exec tmux attach -t "$view" \; set-option destroy-unattached on
  fi
  exec tmux attach -t "$session"
}

open_worktree() {
  local target="$1"
  if command -v workmux >/dev/null 2>&1 && workmux open "$target" 2>/dev/null; then
    return 0
  fi
  local path="$target"
  [ -d "$path" ] || path="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
  tmux new-window -t "$session" -c "$path" -n "$(basename "$path")" "$panes"
}

if [ -n "${TMUX:-}" ]; then
  if [ "$#" -eq 0 ]; then
    exec wtv --panes --close-session
  fi
  for name in "$@"; do
    open_worktree "$name"
  done
  exit 0
fi

start="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"

cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 200)}"
rows="${LINES:-$(tput lines 2>/dev/null || echo 50)}"

if ! tmux has-session -t "$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -x "$cols" -y "$rows" -c "$start" -n "$(basename "$start")" "$panes"
elif [ "$#" -eq 0 ]; then
  tmux new-window -t "$session" -c "$start" -n "$(basename "$start")" "$panes"
fi

for name in "$@"; do
  tmux send-keys -t "$session:^" -l "wtv-up $name"
  tmux send-keys -t "$session:^" Enter
  sleep 1
done

attach
